# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TZ=America/Argentina/Buenos_Aires
PUBLIC_BASE_URL=https://flight-alert-public.onrender.com
PUBLIC_KILL_SWITCH=off

# Telegram Bot
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_BOT_USERNAME=flightalertpro_bot
TELEGRAM_POLLING=false
TELEGRAM_WEBHOOK_SECRET=replace-with-random-hex

# Database
MONGODB_URI=replace-with-mongodb-atlas-uri

# Travelpayouts
TRAVELPAYOUTS_TOKEN=replace-with-travelpayouts-token
TRAVELPAYOUTS_MARKER=793462
TRAVELPAYOUTS_MARKET=ar

# Features
FEATURE_SEARCH=on
FEATURE_ALERTS=on
FEATURE_PAYMENTS_STARS=on
FEATURE_PAYMENTS_MP=on
FEATURE_PAYMENTS_STRIPE=on
FEATURE_CHANNELS=off
FEATURE_INSTANT_ALERTS=on
FEATURE_F3_DESTINATIONS=off

# Plan Limits (JSON or use PlanConfig collection override)
# Free: 1 active alert, daily digest only; Trial: 3 alerts, 7d, 3 instant total; Pro: 30 alerts, 30d, 5 instant/day
PLAN_LIMITS_JSON={"free":{"maxActiveAlerts":1,"digestEnabled":true,"instantAlerts":false,"instantPerDay":0,"monthlySearches":10},"trial":{"maxActiveAlerts":3,"durationDays":7,"digestEnabled":true,"instantAlerts":true,"instantPerDay":3,"monthlySearches":60},"pro":{"maxActiveAlerts":30,"durationDays":30,"digestEnabled":true,"instantAlerts":true,"instantPerDay":5,"monthlySearches":60,"checkIntervalMin":180}}
INSTANT_ALERTS_TRIAL_MAX_TOTAL=3
PRO_SEARCH_PER_MIN=10
PRO_SEARCH_PER_DAY=60
INSTANT_ALERTS_EVERY_HOURS=3
INSTANT_ALERTS_COOLDOWN_HOURS=12
INSTANT_ALERTS_MAX_PER_DAY=5
DIGEST_GRACE_HOURS=3

# Payments (Stripe, Mercado Pago, Telegram Stars)
PAYMENTS_MODE=test
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_WEBHOOK_SECRET_LIVE=whsec_live_replace
STRIPE_PRICE_EUR=price_replace_eur
STRIPE_PRICE_USD=price_replace_usd
STRIPE_TAX_ENABLED=false
MP_ACCESS_TOKEN=TEST-replace
MP_WEBHOOK_SECRET=replace-with-mp-secret
STARS_PAYLOAD_SECRET=replace-with-random-32b
SUPPORT_CONTACT=@ranuk_support

# Security / Funnel / Admin / Broadcast
DEVICE_COOKIE_SECRET=replace-with-random-32b
FUNNEL_HMAC_SALT=replace-with-random-32b
OWNER_TELEGRAM_IDS=
ADMIN_TELEGRAM_IDS=
ADMIN_TOKEN=replace-with-32plus-char-token
BROADCAST_ALLOWLIST=
